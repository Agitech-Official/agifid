---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  htmlLang: string;
  lang: 'fr' | 'en' | 'nl';
  pageType: 'home' | 'sub';
  title: string;
  description: string;
  /** Omit on noindex utility pages (thank-you pages): skips canonical/hreflang/OG/Twitter/JSON-LD. */
  canonical?: string;
  ogLocale?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  robotsNoIndex?: boolean;
  /** Absolute URL of this exact page in the other language. Enables a precise 2-way
      hreflang pair. Omit on pages with no translated counterpart. */
  altLangUrl?: string;
  /** Full set of translations of this page ({fr,en,nl} absolute URLs): 3-way hreflang + language switcher on a sub-page. */
  alternates?: Partial<Record<'fr' | 'en' | 'nl', string>>;
  /** Calendly widget + reCAPTCHA v3 + the postMessage listener - only needed on pages with the contact form. */
  includeContactScripts?: boolean;
}

const {
  htmlLang, lang, pageType, title, description,
  canonical, ogLocale, jsonLd, robotsNoIndex = false,
  altLangUrl, alternates, includeContactScripts = false,
} = Astro.props;

const consent = {
  fr: { text: 'Nous utilisons des cookies de mesure d’audience et publicitaires pour améliorer le site et mesurer nos campagnes. Vous pouvez les accepter ou les refuser.', accept: 'Accepter', refuse: 'Refuser', more: 'Politique de confidentialité', manage: 'Gérer les cookies', privacy: '/politique-de-confidentialite.html#cookies' },
  en: { text: 'We use analytics and advertising cookies to improve the site and measure our campaigns. You can accept or refuse them.', accept: 'Accept', refuse: 'Refuse', more: 'Privacy policy', manage: 'Manage cookies', privacy: '/privacy-policy-en.html#cookies' },
  nl: { text: 'Wij gebruiken analytische en advertentiecookies om de site te verbeteren en onze campagnes te meten. U kunt ze aanvaarden of weigeren.', accept: 'Aanvaarden', refuse: 'Weigeren', more: 'Privacybeleid', manage: 'Cookies beheren', privacy: '/privacybeleid-nl.html#cookies' },
}[lang];
const otherLang = lang === 'fr' ? (altLangUrl?.includes('-nl') ? 'nl' : 'en') : 'fr';
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- Tracking (GTM + GA4) is loaded only after cookie consent: see the consent script before </body>. -->
{robotsNoIndex && <meta name="robots" content="noindex, nofollow">}
<title>{title}</title>
<meta name="description" content={description}>
{canonical && (
  <>
    <link rel="canonical" href={canonical}>
    {pageType === 'home' ? (
      <>
        <link rel="alternate" hreflang="fr" href="https://www.agifid.be/">
        <link rel="alternate" hreflang="en" href="https://www.agifid.be/index-en.html">
        <link rel="alternate" hreflang="nl" href="https://www.agifid.be/index-nl.html">
        <link rel="alternate" hreflang="x-default" href="https://www.agifid.be/">
      </>
    ) : alternates ? (
      <>
        {Object.entries(alternates).map(([code, href]) => <link rel="alternate" hreflang={code} href={href}>)}
        <link rel="alternate" hreflang="x-default" href={alternates.fr ?? canonical}>
      </>
    ) : altLangUrl ? (
      <>
        <link rel="alternate" hreflang={lang} href={canonical}>
        <link rel="alternate" hreflang={otherLang} href={altLangUrl}>
        <link rel="alternate" hreflang="x-default" href={lang === 'fr' ? canonical : altLangUrl}>
      </>
    ) : (
      <link rel="alternate" hreflang={lang} href={canonical}>
    )}
    <meta property="og:type" content="website">
    <meta property="og:locale" content={ogLocale}>
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="AgiFid">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://www.agifid.be/assets/img/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content="https://www.agifid.be/assets/img/og-image.png">
  </>
)}
<link rel="icon" href="/assets/img/Screenshot-2025-08-18-102425.png">
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<!-- Fonts self-hosted as base64 in assets/fonts.css: no external request.
     Loaded non-blocking (preload + swap to stylesheet on load) since the file is ~330KB
     of embedded font data - font-display:swap inside it already lets text render in a
     fallback font immediately, so there's no FOUC risk from not blocking on it. -->
<link rel="preload" href="/assets/fonts.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="/assets/fonts.css"></noscript>
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<Header lang={lang} pageType={pageType} langUrls={alternates} />

<slot />

<Footer lang={lang} pageType={pageType} />

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label={consent.manage} hidden>
  <p>{consent.text} <a href={consent.privacy}>{consent.more}</a></p>
  <div class="cookie-actions">
    <button type="button" class="cookie-refuse" data-consent="denied">{consent.refuse}</button>
    <button type="button" class="cookie-accept" data-consent="granted">{consent.accept}</button>
  </div>
</div>
<script is:inline>
  // GTM and GA4 only load after an explicit "accept" (kept in localStorage).
  // Any element with [data-cookie-settings] re-opens the banner.
  (function () {
    var KEY = 'agifid-consent';
    function load(src) { var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s); }
    function startTracking() {
      if (window.__trackingStarted) return; window.__trackingStarted = true;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      load('https://www.googletagmanager.com/gtm.js?id=GTM-P7LT3M5');
      load('https://www.googletagmanager.com/gtag/js?id=G-2RSXWQS0M1');
      window.gtag = function () { window.dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', 'G-2RSXWQS0M1');
    }
    // Visitors who refuse (or refused earlier) must not keep analytics/ads cookies set before the banner existed.
    function purgeTrackingCookies() {
      var host = location.hostname.replace(/^www\./, '');
      document.cookie.split(';').forEach(function (c) {
        var n = c.split('=')[0].trim();
        if (!/^(_ga|_gid|_gat|_gcl|_clck|_clsk|_fbp)/.test(n)) return;
        [host, '.' + host, 'www.' + host, ''].forEach(function (d) {
          document.cookie = n + '=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/' + (d ? ';domain=' + d : '');
        });
      });
    }
    var banner = document.getElementById('cookie-banner');
    var saved = null; try { saved = localStorage.getItem(KEY); } catch (e) {}
    if (saved === 'granted') startTracking();
    else if (saved === 'denied') purgeTrackingCookies();
    else if (!saved && banner) banner.hidden = false;
    banner && banner.addEventListener('click', function (e) {
      var v = e.target && e.target.getAttribute && e.target.getAttribute('data-consent');
      if (!v) return;
      try { localStorage.setItem(KEY, v); } catch (err) {}
      banner.hidden = true;
      if (v === 'granted') startTracking(); else purgeTrackingCookies();
    });
    document.addEventListener('click', function (e) {
      if (e.target && e.target.closest && e.target.closest('[data-cookie-settings]')) { e.preventDefault(); if (banner) banner.hidden = false; }
    });
  })();
</script>
<script>
  const burgerBtn = document.getElementById('burgerBtn');
  const mainMenu = document.getElementById('mainMenu');
  burgerBtn.addEventListener('click', () => mainMenu.classList.toggle('open'));
  document.querySelectorAll('.main_menu a').forEach(a => a.addEventListener('click', () => mainMenu.classList.remove('open')));
</script>
{includeContactScripts && (
  <script is:inline>
    const RECAPTCHA_SITEKEY = '6LflepEtAAAAAIMLMKQcFU-Kh6tTLgF5_6UlkmCL';

    // Calendly + reCAPTCHA are heavy third-party scripts only needed once the visitor
    // reaches the contact section - loading them eagerly on every page load was tanking
    // Lighthouse (unused JS/CSS, blocking main thread) for content nobody scrolls to yet.
    function loadScript(src, attrs = {}) {
      return new Promise((resolve) => {
        const s = document.createElement('script');
        s.src = src;
        Object.assign(s, attrs);
        s.onload = resolve;
        document.body.appendChild(s);
      });
    }

    let contactScriptsPromise = null;
    function loadContactScripts() {
      if (!contactScriptsPromise) {
        contactScriptsPromise = Promise.all([
          loadScript('https://assets.calendly.com/assets/external/widget.js'),
          loadScript(`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITEKEY}`),
        ]);
      }
      return contactScriptsPromise;
    }

    const contactSection = document.getElementById('contact');
    if (contactSection) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadContactScripts();
          observer.disconnect();
        }
      }, { rootMargin: '600px' });
      observer.observe(contactSection);
    }

    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://calendly.com' || !e.data || !e.data.event) return;

      // The embedded Calendly widget has its own confirmation inside the iframe: without this,
      // a booking never goes through a thank-you page and is never tracked.
      if (e.data.event === 'calendly.event_scheduled') {
        window.location.href = '/merci-rdv.html';
      }

      // Calendly defaults to a fixed height, which creates a scroll inside the iframe (a
      // "page inside the page"). Resync the widget's height to its real content so only
      // the page itself scrolls.
      if (e.data.event === 'calendly.page_height') {
        const widget = document.querySelector('.calendly-inline-widget');
        if (widget && e.data.payload && e.data.payload.height) {
          widget.style.height = e.data.payload.height + 'px';
        }
      }
    });

    // reCAPTCHA v3: generates an invisible token on submit, sets it in the hidden field, then submits.
    document.querySelectorAll('.contact-form').forEach((contactForm) => {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        loadContactScripts().then(() => {
          grecaptcha.ready(() => {
            grecaptcha.execute(RECAPTCHA_SITEKEY, { action: 'contact' }).then((token) => {
              const field = contactForm.querySelector('input[name="g-recaptcha-response"]');
              if (field) field.value = token;
              contactForm.submit();
            });
          });
        });
      });
    });
  </script>
)}
</body>
</html>
