---
import Layout from '../../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import Markdoc from '@markdoc/markdoc';
import { addTocIds } from '../../lib/toc';
import { seoTitle, seoDescription } from '../../lib/seo';

export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const posts = await reader.collections.blog.all();
  return posts
    .filter((p) => p.entry.published)
    .map((p) => ({ params: { slug: p.slug }, props: { entry: p.entry } }));
}

const reader = createReader(process.cwd(), keystaticConfig);
const { entry } = Astro.props;
const relatedSlugs = entry.relatedArticles ?? [];
const relatedEntries = (
  await Promise.all(relatedSlugs.map((slug) => reader.collections.blog.read(slug)))
)
  .map((related, i) => (related ? { slug: relatedSlugs[i], ...related } : null))
  .filter((related): related is NonNullable<typeof related> => related !== null && related.published);

const { node } = await entry.content();
const rendered = Markdoc.renderers.html(Markdoc.transform(node));
const { html: bodyHtml, toc } = addTocIds(rendered);

const wordCount = rendered.replace(/<[^>]+>/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));
const L = entry.lang === 'en' || entry.lang === 'nl' ? entry.lang : 'fr';
const T = {
  fr: { htmlLang: 'fr-BE', date: 'fr-BE', og: 'fr_BE', list: '/actualites.html', insights: 'Actualités', suffix: 'Actualités AgiFid', back: '← Retour aux actualités', read: 'de lecture', toc: 'Sommaire', related: 'À lire aussi', ctaTitle: 'Une question sur votre comptabilité ?', ctaText: 'Parlez-en directement avec un expert AgiFid, sans blabla commercial.', ctaBtn: 'Parler à un expert', home: '/index.html' },
  en: { htmlLang: 'en', date: 'en-GB', og: 'en_GB', list: '/actualites-en.html', insights: 'Insights', suffix: 'AgiFid Insights', back: '← Back to Insights', read: 'read', toc: 'Contents', related: 'Related articles', ctaTitle: 'A question about your accounting?', ctaText: 'Talk directly to an AgiFid expert, no sales pitch.', ctaBtn: 'Talk to an expert', home: '/index-en.html' },
  nl: { htmlLang: 'nl-BE', date: 'nl-BE', og: 'nl_BE', list: '/actualites-nl.html', insights: 'Nieuws', suffix: 'AgiFid Nieuws', back: '← Terug naar het nieuws', read: 'leestijd', toc: 'Inhoud', related: 'Lees ook', ctaTitle: 'Een vraag over uw boekhouding?', ctaText: 'Praat rechtstreeks met een AgiFid-expert, zonder verkooppraatjes.', ctaBtn: 'Praat met een expert', home: '/index-nl.html' },
}[L];
const publishedDate = new Date(entry.date).toLocaleDateString(T.date, { day: 'numeric', month: 'long', year: 'numeric' });

const canonical = `https://www.agifid.be/actualites/${Astro.params.slug}.html`;
const listUrl = `https://www.agifid.be${T.list}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.title,
    description: entry.excerpt,
    datePublished: entry.date,
    author: { '@type': 'Organization', name: entry.author },
    publisher: { '@type': 'Organization', name: 'AgiFid' },
    mainEntityOfPage: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AgiFid', item: 'https://www.agifid.be/' },
      { '@type': 'ListItem', position: 2, name: T.insights, item: listUrl },
      { '@type': 'ListItem', position: 3, name: entry.title, item: canonical },
    ],
  },
];
---
<Layout
  htmlLang={T.htmlLang}
  lang={L}
  pageType="sub"
  title={seoTitle(entry.title, T.suffix)}
  description={seoDescription(entry.excerpt)}
  canonical={canonical}
  ogLocale={T.og}
  jsonLd={jsonLd}
>
<section class="blog-article-section">
  <div class="container">
    <a class="blog-back-link" href={T.list}>{T.back}</a>
    <div class="blog-article-header">
      {entry.category && <span class="blog-category-tag" data-category={entry.category}>{entry.category}</span>}
      <h1>{entry.title}</h1>
      <div class="blog-article-meta">
        <span class="blog-card-date">{publishedDate}</span>
        <span class="blog-article-dot">·</span>
        <span>{entry.author}</span>
        <span class="blog-article-dot">·</span>
        <span>{readingTime} min {T.read}</span>
      </div>
      <p class="blog-article-excerpt">{entry.excerpt}</p>
    </div>
    {entry.coverImage && <img class="blog-article-cover" src={`/assets/img/blog/${entry.coverImage}`} alt={entry.title} loading="lazy" />}
    <div class="blog-article-layout">
      {toc.length > 1 && (
        <aside class="blog-toc">
          <nav>
            <h6>{T.toc}</h6>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </nav>
        </aside>
      )}
      <div class="blog-article-body" set:html={bodyHtml} />
    </div>
    {relatedEntries.length > 0 && (
      <div class="blog-related">
        <h5>{T.related}</h5>
        <div class="blog-related-grid">
          {relatedEntries.map((related) => (
            <a class="blog-related-card" href={`/actualites/${related.slug}.html`}>
              {related.category && <span class="blog-category-tag" data-category={related.category}>{related.category}</span>}
              <h6>{related.title}</h6>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="blog-article-cta">
      <h5>{T.ctaTitle}</h5>
      <p>{T.ctaText}</p>
      <a class="btn btn-violet" href={`${T.home}#contact`}>{T.ctaBtn}</a>
    </div>
  </div>
</section>
</Layout>
