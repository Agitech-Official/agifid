---
import Layout from '../layouts/Layout.astro';

const JOBS_URL = 'https://jobs.agifid.be/fr';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Carrières — AgiFid',
  url: 'https://www.agifid.be/carrieres.html',
  about: { '@type': 'Organization', name: 'AgiFid', url: 'https://www.agifid.be' },
};
---
<Layout
  htmlLang="fr-BE"
  lang="fr"
  pageType="sub"
  title="Carrières — AgiFid"
  description="Rejoignez AgiFid, fiduciaire agréée ITAA 100% sur Odoo. Découvrez nos postes ouverts en Belgique."
  canonical="https://www.agifid.be/carrieres.html"
  alternates={{ fr: "https://www.agifid.be/carrieres.html", en: "https://www.agifid.be/carrieres-en.html", nl: "https://www.agifid.be/carrieres-nl.html" }}
  ogLocale="fr_BE"
  jsonLd={jsonLd}
  includeContactScripts
>
<section class="about-section">
  <div class="container-sm">
    <div class="title">
      <h6 class="eyebrow">Carrières</h6>
      <h1>AgiFid recrute</h1>
      <p>Rejoignez une équipe performante et sympa, au cœur d'une fiduciaire qui travaille directement dans Odoo.</p>
      <p class="about-cta"><a class="btn btn-violet" href={JOBS_URL} target="_blank" rel="noopener">Voir tous nos postes ouverts</a></p>
    </div>

    <img class="career-photo" src="/assets/img/bureau-agitech-agifid.jpg" alt="L'équipe au travail dans nos bureaux d'Auderghem" width="660" height="440" loading="lazy">

    <div class="about-block">
      <h2>Pourquoi AgiFid ?</h2>
      <ul class="about-list">
        <li><strong>Une fiduciaire du futur</strong> — vous travaillez dans Odoo, avec des clients qui pilotent leur entreprise en temps réel.</li>
        <li><strong>Un cadre solide</strong> — membre de l'ITAA : formation continue, déontologie et expertise reconnue.</li>
        <li><strong>L'intégrité comme standard</strong> — on ne vend que ce dont le client a besoin, et on dit non quand c'est mieux pour lui.</li>
        <li><strong>Adossés à Agitech</strong> — une collaboration étroite avec l'intégrateur Odoo certifié pour des dossiers sans friction.</li>
      </ul>
    </div>

    <div class="about-block">
      <h2>Un bureau partagé avec Agitech</h2>
      <p>AgiFid partage ses bureaux d'Auderghem avec Agitech, notre partenaire intégrateur Odoo certifié. Concrètement : vos collègues comptables et les business analysts Odoo travaillent à quelques mètres les uns des autres, et un dossier client se règle autour d'un café plutôt que par une chaîne de mails.</p>
      <p>Les deux sociétés restent juridiquement et opérationnellement indépendantes, mais le bureau, l'ambiance et certains projets communs, eux, sont partagés.</p>
    </div>

    <div class="about-block">
      <h2>Ce que vous trouverez chez nous</h2>
      <div class="career-perks">
        <div class="perk"><h3>Odoo au quotidien</h3><p>Vous travaillez directement dans l'ERP de nos clients, avec des données à jour en continu.</p></div>
        <div class="perk"><h3>Des experts à portée de main</h3><p>Comptables ITAA et spécialistes Odoo sous le même toit pour apprendre vite.</p></div>
        <div class="perk"><h3>Des clients PME</h3><p>Des dirigeants belges avec qui on parle franchement, sans blabla commercial.</p></div>
        <div class="perk"><h3>Une équipe sympa</h3><p>On bosse dur, on rigole bien, dans nos bureaux d'Auderghem.</p></div>
      </div>
    </div>

    <div class="about-cta">
      <a class="btn btn-violet" href={JOBS_URL} target="_blank" rel="noopener">Voir tous nos postes ouverts</a>
      <a class="btn btn-outline" href="#contact">Candidature spontanée</a>
    </div>

    <div class="about-block" id="contact">
      <div class="contact-card">
        <h3>Candidature spontanée</h3>
        <p class="career-intro">Aucun poste ne correspond ? Dites-nous qui vous êtes, on revient vers vous.</p>
        <form class="contact-form" action="https://formspree.io/f/moearzwo" method="POST">
          <div class="form-row">
            <div class="form-field">
              <label for="cf-name">Nom*</label>
              <input type="text" id="cf-name" name="name" required>
            </div>
            <div class="form-field">
              <label for="cf-email">Email*</label>
              <input type="email" id="cf-email" name="email" required>
            </div>
          </div>
          <div class="form-field">
            <label for="cf-phone">Téléphone</label>
            <input type="tel" id="cf-phone" name="phone">
          </div>
          <div class="form-field form-field-full">
            <label for="cf-message">Parlez-nous de vous (lien LinkedIn, profil recherché...)*</label>
            <textarea id="cf-message" name="message" rows="5" required></textarea>
          </div>
          <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="display:none">
          <input type="hidden" name="_subject" value="Candidature spontanée (FR) - AgiFid">
          <input type="hidden" name="_next" value="merci-formulaire.html">
          <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response-jobs">
          <button type="submit" class="btn btn-violet">Envoyer →</button>
        </form>
      </div>
    </div>
  </div>
</section>
</Layout>
