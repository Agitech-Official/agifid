---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const experts = (await reader.collections.experts.all())
  .map((e) => e.entry)
  .sort((a, b) => a.order - b.order);
const hero = await reader.singletons.hero.read();
const methodology = await reader.singletons.methodology.read();
const services360 = await reader.singletons.services360.read();
const offers = await reader.singletons.offers.read();
const itaa = await reader.singletons.itaa.read();
const onboarding = await reader.singletons.onboarding.read();
const faq = await reader.singletons.faq.read();
const contact = await reader.singletons.contact.read();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AccountingService',
    name: 'AgiFid',
    url: 'https://agifid.be/',
    description: "Fiduciaire agréée membre de l'ITAA, 100% dédiée aux sociétés qui pilotent leur comptabilité, fiscalité et gestion sur Odoo.",
    address: {
      '@type': 'PostalAddress',
      streetAddress: '11 Clos Lucien Outers',
      postalCode: '1160',
      addressLocality: 'Brussels',
      addressCountry: 'BE',
    },
    areaServed: 'BE',
    sameAs: [
      'https://www.linkedin.com/company/agitechbelgium/',
      'https://www.youtube.com/@Agitech-OdooPartner',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: onboarding.title,
    description: onboarding.subtitle,
    step: onboarding.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.text,
    })),
  },
];
---
<Layout
  htmlLang="fr-BE"
  lang="fr"
  pageType="home"
  title="AgiFid — Fiduciaire 100% dédiée aux sociétés sur Odoo"
  description="AgiFid, fiduciaire agréée membre de l'ITAA, et Agitech, intégrateur Odoo certifié : comptabilité, fiscalité, paie & RH et conseil financier pour les sociétés qui pilotent leur activité sur Odoo."
  canonical="https://agifid.be/"
  altLangUrl="https://agifid.be/index-en.html"
  ogLocale="fr_BE"
  jsonLd={jsonLd}
  includeContactScripts
>
<section class="home-banner" id="hero">
  <div class="container row">
    <h6>{hero.kicker}</h6>
    <h1>{hero.titleBefore} <span>{hero.titleHighlight}</span><br>{hero.titleAfter}</h1>
    <a class="btn btn-light" href="#contact">{hero.ctaLabel}</a>
  </div>
</section>
<div class="brand-bar"></div>




<section class="certified-experts-section" id="experts">
  <div class="container">
    <h6>Partenaire Odoo Silver</h6>
    <h3>Experts Comptables &amp; Odoo</h3>
    <div class="experts-slider">
      {experts.map((expert) => (
        <div class="expert-member">
          <img src={`assets/img/experts/${expert.photo}`} alt={expert.displayName} loading="lazy">
          <div class="expert-info"><h5>{expert.displayName}</h5><h6>{expert.role}</h6></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="why-section" id="pourquoi">
  <div class="container">
    <div class="why-title"><h3>{methodology.title}</h3></div>
    <div class="row">
      <div class="why-image">
        <div class="why-img"><img src="assets/img/why-choose-us-sec-img-scaled.jpg" alt="Méthodologie Odoo" loading="lazy"></div>
      </div>
      <div class="why-content">
        {methodology.items.map((item, i) => (
          <div class="item">
            <h4>{String(i + 1).padStart(2, '0')}</h4>
            <h5>{item.title}</h5>
            <ul>
              {item.bullets.map((b) => <li>{b.text}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="odoo-expertise-section" id="accompagnement">
  <div class="container">
    <h3>{services360.title}</h3>
    <div class="odoo-expertise-content">
      {services360.items.map((item) => (
        <div class="item">
          <div class="icon"><img src={`assets/img/${item.icon}`} alt={`Icône ${item.title}`} loading="lazy"></div>
          <h6>{item.title}</h6>
          <ul>
            {item.bullets.map((b) => <li>{b.text}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="our-services-section" id="services">
  <div class="container">
    <div class="title">
      <h2>{offers.title}</h2>
      <h6>{offers.subtitle}</h6>
    </div>
    <div class="our-services-content">
      {offers.tiers.map((tier) => (
        <div class="item">
          <a class="item-wrap" href="#contact">
            <h4>{tier.name}</h4>
            <ul>
              {tier.features.map((f) => <li>{f.included ? '✓' : '✗'} {f.text}</li>)}
            </ul>
            <span class="light-page-link">{tier.price}{tier.price.includes('€') && <span class="price-vat">HTVA</span>}</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="union-section">
  <div class="container">
    <h3>AgiFid &amp; Agitech — intégrateur et comptable, enfin réunis.</h3>
    <p class="union-note">AgiFid et Agitech sont deux entités juridiquement et opérationnellement indépendantes, qui collaborent étroitement pour vous offrir un accompagnement coordonné.</p>
    <div class="union-diagram">
      <div class="union-node">
        <div class="tag">Comptable agréé</div>
        <div class="name"><img src="assets/img/logo-agifid-dark.png" alt="AgiFid" loading="lazy"></div>
        <div class="role">Comptabilité, fiscalité, conseil</div>
      </div>
      <div class="union-plus">+</div>
      <div class="union-node">
        <div class="tag">Intégrateur certifié</div>
        <div class="name"><a href="https://agitech.io" target="_blank" rel="noopener"><img src="assets/img/agitech-logo-dark.svg" alt="Agitech" loading="lazy"></a></div>
        <div class="role">Odoo, ERP, infrastructure IT</div>
      </div>
    </div>
    <div class="union-grid">
      <div class="card">
        <h5>Une vraie approche holistique</h5>
        <p>Les business analysts Agitech vous apportent des insights concrets pour piloter votre activité — pas juste rester en règle.</p>
      </div>
      <div class="card">
        <h5>Plus de renvoi de responsabilité</h5>
        <p>L'intégrateur gère Odoo, le comptable gère la compta — avec une coordination directe entre les deux équipes.</p>
      </div>
      <div class="card">
        <h5>Une seule facture</h5>
        <p>Dès lors que la gestion et la comptabilité passent par Odoo via Agitech et AgiFid, tout est réuni sur une seule facture.</p>
      </div>
      <div class="card">
        <h5>De vrais comptables sur vos projets de gestion</h5>
        <p>Votre comptable n'est pas qu'un encodeur : il intervient directement sur vos projets de gestion.</p>
      </div>
    </div>
  </div>
</section>

<section class="methodology-section" id="methodologie">
  <div class="container">
    <div class="row">
      <div class="title">
        <img src="https://www.itaa.be/wp-content/uploads/logo_itaa_transparant.svg" alt="Logo ITAA" style="height:44px; width:auto; margin-bottom:1.25rem;" loading="lazy">
        <h3>{itaa.title}</h3>
      </div>
      <div class="content">
        <div class="para-text"><h6>{itaa.subtitle}</h6></div>
        <div class="row">
          {itaa.items.map((item, i) => (
            <div class="methodology-content"><div class="item"><h4>{String(i + 1).padStart(2, '0')}</h4><h5>{item.title}</h5><p>{item.text}</p></div></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trust-us-section" id="confiance">
  <div class="container">
    <div class="title">
      <h3>98 PME nous font déjà confiance</h3>
      <h6>Patron de PME, nous savons que la qualité d'un ERP se mesure à son impact réel sur votre entreprise, pas au nombre de fonctionnalités.</h6>
    </div>
    <div class="logos-marquee">
      <div class="companies-logos" id="logosTrack">
        <div class="item"><img src="assets/img/Image-logo-proactivedrive.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image23.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image22.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image41.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image40.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image39.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image-logo-supersec.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image37.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image35.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image34.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image33.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image36.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image32.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image31.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image30.png" alt="" loading="lazy"></div>
        <!-- duplicated set below for seamless marquee loop -->
        <div class="item"><img src="assets/img/Image-logo-proactivedrive.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image23.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image22.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image41.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image40.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image39.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image-logo-supersec.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image37.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image35.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image34.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image33.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image36.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image32.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image31.png" alt="" loading="lazy"></div>
        <div class="item"><img src="assets/img/Image30.png" alt="" loading="lazy"></div>
      </div>
    </div>
    <div class="primary-btn">
      <a class="btn btn-violet" href="#contact">Prendre rendez-vous</a>
    </div>
  </div>
</section>

<!-- Section "odoo-intro-section" du site original omise : contenait un texte de test non finalisé ("wef" / "we"). À réintégrer avec le vrai contenu une fois précisé. -->

<section class="onboarding-section" id="onboarding">
  <div class="container">
    <div class="title">
      <h3>{onboarding.title}</h3>
      <p>{onboarding.subtitle}</p>
    </div>
    <div class="onboarding-track">
      {onboarding.steps.map((step, i) => (
        <div class="onboarding-step">
          <div class="num">{String(i + 1).padStart(2, '0')}</div>
          <h5>{step.title}</h5>
          <p>{step.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="faq-section" id="faq">
  <div class="container-sm">
    <div class="title">
      <h3>{faq.title}</h3>
      <p>{faq.subtitle}</p>
    </div>
    <div class="faq-list">
      {faq.items.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="contact-hero" id="contact">
  <div class="container">
    <div class="contact-hero-intro">
      <h2>{contact.titleBefore} <span>{contact.titleHighlight}</span></h2>
      <ul class="trust-list">
        {contact.trustList.map((item) => <li>{item.text}</li>)}
      </ul>

      <h5>{contact.directTitle}</h5>
      <p>{contact.directText}</p>
    </div>
  </div>
  <div class="container contact-hero-row">
    <div class="calendly-embed-wrap">
      <div class="calendly-inline-widget" data-url="https://calendly.com/sam-agitech/25-min-visio-meeting-clone?hide_event_type_details=1&hide_gdpr_banner=1" style="min-width:320px;height:700px;"></div>
      <noscript>
        <p class="calendly-fallback"><a href="https://calendly.com/sam-agitech/25-min-visio-meeting-clone" target="_blank" rel="noopener">Réserver un créneau sur Calendly</a></p>
      </noscript>
    </div>

    <div class="contact-card">
      <h3>Échangez par email</h3>
      <!-- TODO: le champ _next doit pointer vers l'URL absolue de merci-formulaire.html sur le domaine final,
           et être ajouté aux redirections autorisées dans les paramètres du formulaire Formspree. -->
      <form class="contact-form" action="https://formspree.io/f/moearzwo" method="POST">
        <div class="form-row">
          <div class="form-field">
            <label for="cf-name">Nom*</label>
            <input type="text" id="cf-name" name="name" required>
          </div>
          <div class="form-field">
            <label for="cf-company">Société*</label>
            <input type="text" id="cf-company" name="company" required>
          </div>
        </div>
        <div class="form-row">
          <div class="form-field">
            <label for="cf-email">Email*</label>
            <input type="email" id="cf-email" name="email" required>
          </div>
          <div class="form-field">
            <label for="cf-phone">Téléphone*</label>
            <input type="tel" id="cf-phone" name="phone" required>
          </div>
        </div>
        <div class="form-field form-field-full">
          <label for="cf-message">Comment pouvons-nous vous aider ? (optionnel)</label>
          <textarea id="cf-message" name="message" rows="4"></textarea>
        </div>
        <input type="hidden" name="_subject" value="Nouvelle demande de contact - AgiFid">
        <input type="hidden" name="_next" value="merci-formulaire.html">
        <!-- reCAPTCHA v3 (invisible) : le token est généré au submit, cf script en bas de page.
             Secret key à activer dans les paramètres du formulaire Formspree (pas dans le code). -->
        <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response-fr">
        <button type="submit" class="btn btn-violet">Envoyer →</button>
      </form>
    </div>
  </div>
</section>
</Layout>
