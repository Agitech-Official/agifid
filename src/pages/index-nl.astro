---
import Layout from '../layouts/Layout.astro';

const faqItems = [
  {
    question: 'Wat is AgiFid?',
    answer: 'AgiFid is een erkend boekhoudkantoor (ITAA-lid), 100% gewijd aan bedrijven die hun boekhouding, fiscaliteit en beheer op Odoo uitvoeren. Het werkt nauw samen met Agitech, een gecertificeerde Odoo-integrator, voor een afgestemde begeleiding tussen boekhouding en beheertools.',
  },
  {
    question: 'Hoeveel kost een boekhouder voor een kmo in België?',
    answer: 'Reken op ongeveer €150 tot enkele honderden euro per maand, afhankelijk van de grootte van het bedrijf, het btw-stelsel en het aantal documenten. Bij AgiFid zijn de prijzen vast en transparant: €3.500 excl. btw/jaar voor een beheersvennootschap, €6.500 excl. btw/jaar voor 1 tot 5 VTE, en op aanvraag daarboven.',
  },
  {
    question: 'Hoe kies ik een goede boekhouder in België?',
    answer: 'Controleer eerst of hij lid is van het ITAA: alleen die beschermde titel garandeert erkende expertise, permanente opleiding en strenge deontologie. Vergelijk daarna de transparantie van de prijzen, de reactiesnelheid en de specialisatie in uw sector of beheertool (bijvoorbeeld Odoo).',
  },
  {
    question: 'Kan ik halverwege het jaar van boekhouder veranderen?',
    answer: 'Ja, u kunt op elk moment van boekhouder veranderen, mits u de opzegtermijn in uw contract respecteert (of een redelijke termijn bij een mondelinge afspraak). Het nieuwe kantoor haalt uw dossiers op bij het vorige; bij AgiFid wordt deze overgang vanaf het kennismakingsgesprek geregeld.',
  },
  {
    question: 'Is elektronische facturatie (PEPPOL) verplicht in België?',
    answer: 'Ja, sinds 1 januari 2026 is elektronische facturatie in PEPPOL-formaat verplicht voor btw-plichtige ondernemingen in België. Odoo ondersteunt deze standaard rechtstreeks, wat de naleving vergemakkelijkt voor bedrijven die al op Odoo werken.',
  },
  {
    question: 'Vervangt Odoo een boekhouder of boekhoudkantoor?',
    answer: 'Nee. Odoo is een beheertool die facturatie, aankopen en boekhouding centraliseert, maar vervangt de wettelijke rol van de boekhouder niet. Het boekhoudkantoor blijft verantwoordelijk voor de fiscale naleving, de btw-aangiften en de goedkeuring van de jaarrekening — Odoo maakt dat werk eenvoudiger en betrouwbaarder, maar komt er niet in de plaats van.',
  },
  {
    question: 'Wat is het verschil tussen een boekhouder en een erkend accountant in België?',
    answer: '"Accountant" (expert-comptable) is een beschermde titel, voorbehouden aan ITAA-leden die een erkende opleiding hebben gevolgd en onder strenge deontologie en kwaliteitscontrole vallen. Een niet-erkende boekhouder mag een boekhouding voeren, maar kan niet dezelfde beroepsaansprakelijkheid dragen of die titel gebruiken.',
  },
  {
    question: 'Wat is het ITAA en waarom is dat belangrijk?',
    answer: 'Het ITAA (Instituut voor de Accountants en de Belastingadviseurs) is de Belgische instantie die het beroep van accountant en belastingadviseur reglementeert. Lid zijn van het ITAA garandeert erkende expertise, verplichte permanente opleiding en strenge deontologie — wat de klant rechtstreeks beschermt.',
  },
  {
    question: 'Wat is het verschil tussen AgiFid en Agitech?',
    answer: 'AgiFid en Agitech zijn twee juridisch en operationeel onafhankelijke entiteiten. AgiFid is de erkende boekhouder (boekhouding, fiscaliteit, advies), Agitech is de gecertificeerde Odoo-integrator (ERP, IT-infrastructuur). Ze werken nauw samen om het klassieke heen-en-weer schuiven van verantwoordelijkheid tussen boekhouder en integrator te vermijden.',
  },
  {
    question: 'Als ik mijn contract met AgiFid of Agitech beëindig, moet ik dan ook met de andere stoppen?',
    answer: 'Nee, er is geen lock-in. AgiFid en Agitech zijn twee juridisch en operationeel onafhankelijke entiteiten, elk met een eigen contract met u. Het beëindigen van uw boekhoudcontract met AgiFid heeft geen invloed op uw Odoo-contract met Agitech, en omgekeerd: u bent vrij om met een van beide, of met beide, door te gaan.',
  },
  {
    question: 'Moet ik al op Odoo werken om klant van AgiFid te worden?',
    answer: 'Nee. AgiFid leidt zijn klanten op in Odoo-boekhouding als onderdeel van de onboarding, met een specifieke sessie over gegevensinvoer en boekhoudbeheer. Bedrijven die nog niet op Odoo zitten, kunnen samen met Agitech worden begeleid om de ERP in te stellen.',
  },
  {
    question: 'Wat zijn de boekhoudkundige verplichtingen van een BV in België?',
    answer: 'Een BV moet een dubbele boekhouding voeren, elk jaar de jaarrekening neerleggen bij de Nationale Bank van België en periodieke btw-aangiften indienen (maandelijks of driemaandelijks, afhankelijk van het stelsel). Ze moet ook de vennootschapsbelasting aangeven en betalen.',
  },
  {
    question: 'Hoe lang duurt het om met een nieuw boekhoudkantoor te starten?',
    answer: 'Bij AgiFid verloopt de onboarding in 5 stappen: kennismakingsgesprek, ondertekening van de opdrachtbrief, bepaling van een fiscale structuur, opleiding in Odoo-boekhouding, en daarna de start van de boekhouding met periodieke opvolging. De duur hangt vooral af van de beschikbaarheid van de klant tijdens de opleidingsfase.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'AccountingService',
    name: 'AgiFid',
    url: 'https://www.agifid.be/index-nl.html',
    description: 'Erkend boekhoudkantoor (ITAA-lid), 100% gewijd aan bedrijven die hun boekhouding, fiscaliteit en beheer op Odoo uitvoeren.',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '11 Clos Lucien Outers',
      postalCode: '1160',
      addressLocality: 'Brussel',
      addressCountry: 'BE',
    },
    areaServed: 'BE',
    sameAs: [
      'https://www.linkedin.com/company/agitechbelgium/',
      'https://www.youtube.com/@Agitech-OdooPartner',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Ons onboardingproces',
    description: 'Van het eerste contact tot volle snelheid: een duidelijk traject in 5 stappen.',
    step: [
      { '@type': 'HowToStep', position: 1, name: 'Kennismakingsgesprek', text: 'We bespreken uw situatie, behoeften en doelstellingen.' },
      { '@type': 'HowToStep', position: 2, name: 'Opdrachtbrief ondertekend', text: 'We leggen onze samenwerking en de omvang van onze diensten vast.' },
      { '@type': 'HowToStep', position: 3, name: 'Bepaling van een fiscale structuur', text: 'Een optimalisatiemodel op maat van uw situatie, dat onze volledige begeleiding omkadert.' },
      { '@type': 'HowToStep', position: 4, name: 'Opleiding Odoo-boekhouding', text: 'We leiden u op in gegevensinvoer en het beheer van uw boekhouding in Odoo.' },
      { '@type': 'HowToStep', position: 5, name: 'Lopende boekhouding', text: 'Permanente opvolging, met periodieke controles van uw rekeningen en beheerscontrole.' },
    ],
  },
];
