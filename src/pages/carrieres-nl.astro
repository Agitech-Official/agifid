---
import Layout from '../layouts/Layout.astro';

const JOBS_URL = 'https://jobs.agifid.be';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Jobs — AgiFid',
  url: 'https://www.agifid.be/carrieres-nl.html',
  about: { '@type': 'Organization', name: 'AgiFid', url: 'https://www.agifid.be' },
};
---
<Layout
  htmlLang="nl-BE"
  lang="nl"
  pageType="sub"
  title="Jobs — AgiFid"
  description="Word lid van het team van AgiFid, ITAA-erkend boekhoudkantoor 100% op Odoo. Ontdek onze openstaande vacatures in België."
  canonical="https://www.agifid.be/carrieres-nl.html"
  altLangUrl="https://www.agifid.be/carrieres.html"
  ogLocale="nl_BE"
  jsonLd={jsonLd}
>
<section class="about-section">
  <div class="container-sm">
    <div class="title">
      <h6 class="eyebrow">Jobs</h6>
      <h1>AgiFid zoekt collega's</h1>
      <p>Word lid van een performant en leuk team, in een boekhoudkantoor dat rechtstreeks in Odoo werkt.</p>
      <p class="about-cta"><a class="btn btn-violet" href={JOBS_URL} target="_blank" rel="noopener">Bekijk al onze vacatures</a></p>
    </div>

    <img class="career-photo" src="/assets/img/bureau-agitech-agifid.jpg" alt="Het team aan het werk in onze kantoren in Oudergem" width="660" height="440" loading="lazy">

    <div class="about-block">
      <h2>Waarom AgiFid?</h2>
      <ul class="about-list">
        <li><strong>Een boekhoudkantoor van de toekomst</strong> — u werkt in Odoo, met klanten die hun bedrijf in real time sturen.</li>
        <li><strong>Een solide kader</strong> — lid van het ITAA: permanente opleiding, deontologie en erkende expertise.</li>
        <li><strong>Integriteit als standaard</strong> — we verkopen enkel wat de klant nodig heeft, en we zeggen nee als dat beter is voor hem.</li>
        <li><strong>Verbonden met Agitech</strong> — een nauwe samenwerking met de gecertificeerde Odoo-integrator voor dossiers zonder wrijving.</li>
      </ul>
    </div>

    <div class="about-block">
      <h2>Een kantoor gedeeld met Agitech</h2>
      <p>AgiFid deelt zijn kantoren in Oudergem met Agitech, onze gecertificeerde Odoo-integrator en partner. Concreet: uw collega-boekhouders en de Odoo business analysts werken op enkele meters van elkaar, en een klantendossier wordt opgelost bij een kop koffie in plaats van via een keten van mails.</p>
      <p>De twee bedrijven blijven juridisch en operationeel onafhankelijk, maar het kantoor, de sfeer en een aantal gezamenlijke projecten worden gedeeld.</p>
    </div>

    <div class="about-block">
      <h2>Wat u bij ons vindt</h2>
      <div class="career-perks">
        <div class="perk"><h3>Odoo elke dag</h3><p>U werkt rechtstreeks in de ERP van onze klanten, met voortdurend actuele gegevens.</p></div>
        <div class="perk"><h3>Experts binnen handbereik</h3><p>ITAA-boekhouders en Odoo-specialisten onder één dak om snel te leren.</p></div>
        <div class="perk"><h3>Kmo-klanten</h3><p>Belgische ondernemers met wie we open praten, zonder verkooppraatjes.</p></div>
        <div class="perk"><h3>Een leuk team</h3><p>We werken hard en lachen graag, in onze kantoren in Oudergem.</p></div>
      </div>
    </div>

    <div class="about-cta">
      <a class="btn btn-violet" href={JOBS_URL} target="_blank" rel="noopener">Bekijk al onze vacatures</a>
      <a class="btn btn-outline" href="/index-nl.html#contact">Spontane sollicitatie</a>
    </div>
  </div>
</section>
</Layout>
