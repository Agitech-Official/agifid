---
// Landing page for Google Ads ("comptable Bruxelles"). NOT indexed: noindex + not in sitemap +
// no internal link to it. Do not block it in robots.txt (AdsBot must be able to crawl it).
// Content is reused from the Keystatic singletons / collections used by the home page.
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const methodology = await reader.singletons.methodology.read();
const services360 = await reader.singletons.services360.read();
const itaa = await reader.singletons.itaa.read();
const offers = await reader.singletons.offers.read();
const onboarding = await reader.singletons.onboarding.read();
const faq = await reader.singletons.faq.read();
const experts = (await reader.collections.experts.all())
  .map((e) => e.entry)
  .sort((a, b) => a.order - b.order);

// TODO (Diego): confirm the offer. A concrete deliverable should replace the generic "rendez-vous",
// e.g. a diagnostic of the Odoo accounting with 3 quantified time savings (NOT confirmed, do not publish as is).
const OFFER = {
  subtitle: 'Votre comptable à Bruxelles travaille directement dans votre Odoo.',
  cta: 'Prendre rendez-vous',
};

// TODO (Diego): "Membre ITAA", "98 PME" and "agréé" are not shown until verified (ITAA registration request
// sent on 26/10/2026; "98 PME" source unconfirmed). Set to true once confirmed.
const SHOW_UNVERIFIED_CLAIMS = true; // Diego asked to show them (06/11/2026): keep the ITAA registration proof and the 98 PME source on file
const reassurance = SHOW_UNVERIFIED_CLAIMS
  ? 'Membre agréé ITAA · 98 PME · Partenaire Odoo Silver'
  : 'Partenaire Odoo Silver · Tarifs fixes · 100 % sur Odoo';

// Cases: named references. Diego confirmed (06/11/2026) that every client signs a purchase order in which they
// specifically agree to be cited. TODO: keep the signed orders on file and check the clause covers a public
// reference on a website. Facts only (what was done and what the client reported to AgiFid). No figures that the
// client has not confirmed (e.g. the number of consolidated companies at MAJA). No quotation marks: the "feedback"
// lines are reported speech, not client quotes.
const CASES = [
  {
    name: 'MAJA',
    tag: 'Groupe de sociétés',
    mission: 'Reprise des dossiers comptables et mise en place d’Odoo avec consolidation multi-sociétés. La preuve de concept est finalisée : un reporting consolidé de tout le groupe, directement connecté à Odoo.',
    feedback: 'Très satisfait du résultat.',
    author: 'Alexis LH.',
  },
  {
    name: 'LDK Consulting',
    tag: 'Société de management',
    mission: 'Élaboration d’un schéma fiscal adapté à la situation du dirigeant, chiffres accessibles en continu dans Odoo et situations intermédiaires régulières avec l’équipe.',
    feedback: 'Ravi du schéma fiscal : il voit ses chiffres en temps réel, les comprend et apprécie les situations intermédiaires.',
    author: 'Ladislas DK',
  },
  {
    name: 'SEFA',
    tag: 'ASBL',
    mission: 'Reprise du dossier comptable et fiscal depuis un autre cabinet, mise en place d’Odoo (CODA, facturation des cotisations, timesheets), comptabilité analytique et contrôle de gestion.',
    feedback: 'Satisfaite du suivi, de la mise en place de la comptabilité analytique et du contrôle de gestion.',
    author: 'Lina A.',
  },
];
// TODO (Diego): the feedback lines are AgiFid's summary of what each client reported, written without quotation
// marks. Once a client has validated the exact wording in writing, set quoted: true on that case (label becomes
// "Retour cité" and the text goes between guillemets). Role/function of the signatories is not shown (unknown).

// TODO (Diego): client quotes. NOT displayed. A quote is published only with written client agreement
// (e-mail is enough) and the exact first name, role and company. Texts below are drafts to SEND for validation,
// they are not client quotes. Set approved to true and fill author once the client has answered in writing.
const TESTIMONIALS = [
  { approved: false, company: 'MAJA', author: '', quote: 'Le POC est finalisé : nous disposons d’un reporting consolidé de nos sociétés grâce à l’intégration MCP. Nous sommes très satisfaits du résultat.' },
  { approved: false, company: 'LDK Consulting', author: '', quote: 'Je suis ravi du schéma fiscal élaboré pour ma société de management. Je vois mes chiffres en temps réel, je les comprends, et j’apprécie d’avoir des situations intermédiaires avec l’équipe.' },
  { approved: false, company: 'SEFA', author: '', quote: 'Nous sommes très satisfaits du suivi, de la mise en place de notre comptabilité analytique et du contrôle de gestion.' },
];
const approvedQuotes = TESTIMONIALS.filter((t) => t.approved && t.author);

// FAQ: cost, how to choose, switching mid-year, do I need Odoo, AgiFid vs Agitech
const FAQ_ORDER = [1, 2, 3, 10, 8];
// "agréé" is not shown on this page until the ITAA registration is confirmed (see SHOW_UNVERIFIED_CLAIMS).
const faqItems = FAQ_ORDER.map((i) => faq.items[i]).filter(Boolean).map((item) => ({
  ...item,
  answer: SHOW_UNVERIFIED_CLAIMS ? item.answer : item.answer.replace('le comptable agréé', 'le comptable'),
}));
const roleLabel = (role: string) => (SHOW_UNVERIFIED_CLAIMS ? role : role.replace(' ITAA', ''));

const CALENDLY = 'https://calendly.com/sam-agitech/25-min-visio-meeting-clone?hide_event_type_details=1&hide_gdpr_banner=1';
---
<Layout
  htmlLang="fr-BE"
  lang="fr"
  pageType="sub"
  title="Cabinet comptable à Bruxelles | AgiFid, 100 % sur Odoo"
  description="Cabinet comptable ITAA à Bruxelles, 100 % sur Odoo : tarifs fixes dès 3 500 € HTVA/an. Prenez rendez-vous avec un comptable AgiFid."
  canonical="https://www.agifid.be/comptable-bruxelles.html"
  ogLocale="fr_BE"
  robotsNoIndex
  includeContactScripts
  landing
>
<header class="sea-header">
  <div class="container sea-header-wrap">
    <span class="logo"><img src="/assets/img/logo-agifid.png" alt="AgiFid" width="944" height="314"></span>
    <a class="sea-header-cta" href="#contact" data-sea-cta="header">{OFFER.cta}</a>
  </div>
</header>

<section class="home-banner sea-hero">
  <div class="container row">
    <h6>Cabinet comptable · Bruxelles</h6>
    <h1>Cabinet comptable à Bruxelles <span>pour sociétés sur Odoo</span></h1>
    <p class="sea-hero-lead">{OFFER.subtitle}</p>
    <a class="btn btn-violet" href="#contact" data-sea-cta="hero">{OFFER.cta}</a>
    <p class="sea-reassurance">{reassurance}</p>
  </div>
</section>
<div class="brand-bar"></div>

<section class="certified-experts-section">
  <div class="container">
    <h6>Partenaire Odoo Silver</h6>
    <h2 class="sea-section-h">Votre équipe comptable à Bruxelles</h2>
    <div class="experts-slider">
      {experts.map((expert) => (
        <div class="expert-member">
          <img src={`/assets/img/experts/${expert.photo}`} alt={expert.displayName} width="700" height="700" loading="lazy">
          <div class="expert-info"><h5>{expert.displayName}</h5><h6>{roleLabel(expert.role)}</h6></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="why-section" id="pourquoi">
  <div class="container">
    <div class="why-title"><h2 class="sea-section-h">Pourquoi choisir un comptable AgiFid à Bruxelles ?</h2></div>
    <div class="row">
      <div class="why-image">
        <div class="why-img"><img src="/assets/img/why-choose-us-sec-img-scaled.jpg" alt="Un comptable AgiFid travaille dans Odoo" width="660" height="440" loading="lazy"></div>
      </div>
      <div class="why-content">
        {methodology.items.map((item, i) => (
          <div class="item">
            <h4>{String(i + 1).padStart(2, '0')}</h4>
            <h5>{item.title}</h5>
            <ul>
              {item.bullets.map((b) => <li>{b.text}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="sea-cases">
  <div class="container">
    <div class="title">
      <h2 class="sea-section-h">Ce que nous faisons pour nos clients</h2>
    </div>
    <div class="sea-cases-grid">
      {CASES.map((c) => (
        <article class="sea-case">
          <span class="sea-case-tag">{c.name} · {c.tag}</span>
          <p class="sea-case-mission"><strong>Mission :</strong> {c.mission}</p>
          <p class="sea-case-feedback"><strong>{c.quoted ? 'Retour cité' : 'Retour client'} :</strong> {c.quoted ? `« ${c.feedback} »` : c.feedback}<span class="sea-case-author"> — {c.author}, {c.name}</span></p>
        </article>
      ))}
    </div>
    {approvedQuotes.length > 0 && (
      <div class="sea-quotes">
        {approvedQuotes.map((t) => (
          <blockquote class="sea-quote"><p>« {t.quote} »</p><footer>{t.author}, {t.company}</footer></blockquote>
        ))}
      </div>
    )}
    <p class="sea-cta-row"><a class="btn btn-violet" href="#contact" data-sea-cta="cas-clients">{OFFER.cta}</a></p>
  </div>
</section>

<section class="odoo-expertise-section">
  <div class="container">
    <h3>{services360.title}</h3>
    <div class="odoo-expertise-content">
      {services360.items.map((item) => (
        <div class="item">
          <div class="icon"><img src={`assets/img/${item.icon}`} alt={`Icône ${item.title}`} loading="lazy"></div>
          <h6>{item.title}</h6>
          <ul>
            {item.bullets.map((b) => <li>{b.text}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="our-services-section" id="tarifs">
  <div class="container">
    <div class="title">
      <h2>{offers.title}</h2>
      <h6>{offers.subtitle}</h6>
    </div>
    <div class="our-services-content">
      {offers.tiers.map((tier) => (
        <div class="item">
          <a class="item-wrap" href="#contact" data-sea-cta="tarifs">
            <h4>{tier.name}</h4>
            <ul>
              {tier.features.map((f) => <li>{f.included ? '✓' : '✗'} {f.text}</li>)}
            </ul>
            <span class="light-page-link">{tier.price}{tier.price.includes('€') && <span class="price-vat">HTVA</span>}</span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="union-section">
  <div class="container">
    <h3>AgiFid &amp; Agitech — intégrateur et comptable, enfin réunis.</h3>
    <p class="union-note">AgiFid et Agitech sont deux entités juridiquement et opérationnellement indépendantes, qui collaborent étroitement pour vous offrir un accompagnement coordonné.</p>
    <div class="union-diagram">
      <div class="union-node">
        <div class="tag">{SHOW_UNVERIFIED_CLAIMS ? "Comptable agréé" : "Comptable"}</div>
        <div class="name"><img src="/assets/img/logo-agifid-dark.png" alt="AgiFid" loading="lazy"></div>
        <div class="role">Comptabilité, fiscalité, conseil</div>
      </div>
      <div class="union-plus">+</div>
      <div class="union-node">
        <div class="tag">Intégrateur certifié</div>
        <div class="name"><img src="/assets/img/agitech-logo-dark.svg" alt="Agitech" loading="lazy"></div>
        <div class="role">Odoo, ERP, infrastructure IT</div>
      </div>
    </div>
    <div class="union-grid">
      <div class="card">
        <h5>Une vraie approche holistique</h5>
        <p>Les business analysts Agitech vous apportent des insights concrets pour piloter votre activité — pas juste rester en règle.</p>
      </div>
      <div class="card">
        <h5>Plus de renvoi de responsabilité</h5>
        <p>L'intégrateur gère Odoo, le comptable gère la compta — avec une coordination directe entre les deux équipes.</p>
      </div>
      <div class="card">
        <h5>De vrais comptables sur vos projets de gestion</h5>
        <p>Votre comptable n'est pas qu'un encodeur : il intervient directement sur vos projets de gestion.</p>
      </div>
    </div>
  </div>
</section>

<section class="methodology-section">
  <div class="container">
    <div class="row">
      <div class="title">
        <img src="https://www.itaa.be/wp-content/uploads/logo_itaa_transparant.svg" alt="Logo ITAA" style="height:44px; width:auto; margin-bottom:1.25rem;" loading="lazy">
        <h3>{itaa.title}</h3>
      </div>
      <div class="content">
        <div class="para-text"><h6>{itaa.subtitle}</h6></div>
        <div class="row">
          {itaa.items.map((item, i) => (
            <div class="methodology-content"><div class="item"><h4>{String(i + 1).padStart(2, '0')}</h4><h5>{item.title}</h5><p>{item.text}</p></div></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="trust-us-section">
  <div class="container">
    <div class="title">
      <h3>98 PME nous font déjà confiance</h3>
      <h6>Patron de PME, nous savons que la qualité d'un ERP se mesure à son impact réel sur votre entreprise, pas au nombre de fonctionnalités.</h6>
    </div>
    <div class="logos-marquee">
      <div class="companies-logos" id="logosTrack">
        <div class="item"><img src="/assets/img/Image-logo-proactivedrive.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image23.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image22.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image41.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image40.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image39.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image-logo-supersec.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image37.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image35.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image34.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image33.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image36.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image32.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image31.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image30.png" alt="" loading="lazy"></div>
        <!-- duplicated set below for seamless marquee loop -->
        <div class="item"><img src="/assets/img/Image-logo-proactivedrive.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image23.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image22.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image41.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image40.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image39.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image-logo-supersec.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image37.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image35.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image34.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image33.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image36.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image32.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image31.png" alt="" loading="lazy"></div>
        <div class="item"><img src="/assets/img/Image30.png" alt="" loading="lazy"></div>
      </div>
    </div>
    <div class="primary-btn">
      <a class="btn btn-violet" href="#contact" data-sea-cta="confiance">Prendre rendez-vous</a>
    </div>
  </div>
</section>


<section class="onboarding-section sea-onboarding">
  <div class="container">
    <div class="title">
      <h2>Comment démarrer avec notre cabinet comptable</h2>
      <p>{onboarding.subtitle}</p>
    </div>
    <div class="onboarding-track">
      {onboarding.steps.map((s, i) => (
        <div class="onboarding-step">
          <div class="num">0{i + 1}</div>
          <h5>{s.title}</h5>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="faq-section" id="faq">
  <div class="container-sm">
    <div class="title">
      <h2>Questions fréquentes sur le comptable à Bruxelles</h2>
    </div>
    <div class="faq-list">
      {faqItems.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="contact-hero sea-contact" id="contact">
  <div class="container">
    <div class="contact-hero-intro">
      <h2>Parlons de votre comptabilité avec un comptable à Bruxelles</h2>
      <p>Réservez un créneau de 25 minutes. Pas de blabla commercial : vous parlez directement avec un expert AgiFid.</p>
    </div>
  </div>
  <div class="container contact-hero-row">
    <div class="calendly-embed-wrap">
      <div class="calendly-inline-widget" data-url={CALENDLY} style="min-width:320px;height:700px;"></div>
      <noscript>
        <p class="calendly-fallback"><a href="https://calendly.com/sam-agitech/25-min-visio-meeting-clone" target="_blank" rel="noopener">Réserver un créneau sur Calendly</a></p>
      </noscript>
    </div>

    <div class="contact-card">
      <h3>Ou laissez-nous vos coordonnées</h3>
      <form class="contact-form" id="sea-form" action="https://formspree.io/f/moearzwo" method="POST">
        <div class="form-field">
          <label for="sea-name">Nom*</label>
          <input type="text" id="sea-name" name="name" autocomplete="name" required>
        </div>
        <div class="form-field">
          <label for="sea-email">Email*</label>
          <input type="email" id="sea-email" name="email" autocomplete="email" required>
        </div>
        <div class="form-field">
          <label for="sea-phone">Téléphone*</label>
          <input type="tel" id="sea-phone" name="phone" autocomplete="tel" required>
        </div>
        <input type="hidden" name="_subject" value="Demande de rendez-vous (page comptable Bruxelles) - AgiFid">
        <input type="hidden" name="_next" value="merci-formulaire.html">
        <input type="hidden" name="source_page" value="comptable-bruxelles">
        <input type="hidden" name="gclid" data-track="gclid">
        <input type="hidden" name="utm_source" data-track="utm_source">
        <input type="hidden" name="utm_medium" data-track="utm_medium">
        <input type="hidden" name="utm_campaign" data-track="utm_campaign">
        <input type="hidden" name="utm_term" data-track="utm_term">
        <input type="hidden" name="utm_content" data-track="utm_content">
        <input type="hidden" name="g-recaptcha-response" id="g-recaptcha-response-sea">
        <button type="submit" class="btn btn-violet">Être rappelé →</button>
      </form>
    </div>
  </div>
</section>

<footer class="sea-footer">
  <div class="container">
    <!-- TODO (Diego): confirm the legal wording "AgiFid, marque de Mfinances" (legal entity: MFINANCES SRL). -->
    <p><strong>AgiFid</strong>, marque de Mfinances · Bruxelles, Belgique · TVA BE 0827635870</p>
    <p class="sea-footer-links">
      <a href="/politique-de-confidentialite.html">Politique de confidentialité</a>
      <span>|</span>
      <a href="/conditions-generales.html">Conditions générales</a>
      <span>|</span>
      <a href="#" data-cookie-settings>Gérer les cookies</a>
    </p>
  </div>
</footer>

<script is:inline>
  // Conversion events (pushed to the dataLayer; GTM only runs after cookie consent) and gclid/UTM carry-over.
  (function () {
    window.dataLayer = window.dataLayer || [];
    var KEYS = ['gclid', 'gbraid', 'wbraid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
    var params = {};
    try {
      var q = new URLSearchParams(location.search);
      KEYS.forEach(function (k) { if (q.get(k)) params[k] = q.get(k); });
      if (Object.keys(params).length) sessionStorage.setItem('sea-params', JSON.stringify(params));
      else params = JSON.parse(sessionStorage.getItem('sea-params') || '{}');
    } catch (e) {}

    document.querySelectorAll('[data-track]').forEach(function (el) {
      var k = el.getAttribute('data-track');
      if (params[k]) el.value = params[k];
    });

    // Calendly understands utm_* only: gclid stays in the form (hidden field) and in sessionStorage.
    var widget = document.querySelector('.calendly-inline-widget');
    if (widget) {
      var url = new URL(widget.getAttribute('data-url'));
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(function (k) {
        if (params[k]) url.searchParams.set(k, params[k]);
      });
      widget.setAttribute('data-url', url.toString());
    }

    document.addEventListener('click', function (e) {
      var cta = e.target.closest && e.target.closest('[data-sea-cta]');
      if (cta) window.dataLayer.push({ event: 'sea_cta_click', cta_position: cta.getAttribute('data-sea-cta'), page: 'comptable-bruxelles' });
    });
    var form = document.getElementById('sea-form');
    if (form) form.addEventListener('submit', function () {
      window.dataLayer.push({ event: 'sea_form_submit', page: 'comptable-bruxelles' });
    });
    window.addEventListener('message', function (e) {
      if (e.origin === 'https://calendly.com' && e.data && e.data.event === 'calendly.event_scheduled') {
        window.dataLayer.push({ event: 'sea_calendly_scheduled', page: 'comptable-bruxelles' });
      }
    });
  })();
</script>
</Layout>
