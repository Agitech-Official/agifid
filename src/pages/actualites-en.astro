---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const posts = (await reader.collections.blog.all())
  .map((p) => ({ slug: p.slug, ...p.entry }))
  .filter((p) => p.published && p.lang === 'en')
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---
<Layout
  htmlLang="en"
  lang="en"
  pageType="sub"
  title="Insights — AgiFid"
  description="Accounting, tax, payroll and Odoo management: our experts break down Belgian tax and accounting news with practical advice."
  canonical="https://agifid.be/actualites-en.html"
  altLangUrl="https://agifid.be/actualites.html"
  ogLocale="en_GB"
>
<section class="blog-list-section">
  <div class="container">
    <div class="title">
      <h6 class="eyebrow">Insights</h6>
      <h1>Accounting, tax & Odoo: expert advice</h1>
      <p>Our team of accountants and Odoo experts breaks down Belgian tax and accounting news, and shares practical advice to help you run your business with confidence — no unnecessary jargon.</p>
    </div>
    <div class="blog-list-grid">
      {posts.map((post) => (
        <a class="blog-card" href={`/actualites/${post.slug}.html`}>
          {post.coverImage && <img src={`/assets/img/blog/${post.coverImage}`} alt={post.title} loading="lazy" />}
          <div class="blog-card-body">
            {post.category && <span class="blog-category-tag" data-category={post.category}>{post.category}</span>}
            <h3>{post.title}</h3>
            <p>{post.excerpt}</p>
            <span class="blog-card-date">{new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </div>
        </a>
      ))}
      {posts.length === 0 && <p>No articles published yet.</p>}
    </div>
  </div>
</section>
</Layout>
