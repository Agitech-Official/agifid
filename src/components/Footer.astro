---
export interface Props {
  lang: 'fr' | 'en' | 'nl';
  /** 'home' = index.html / index-en.html. 'sub' = any other page (nav anchors point back to index.html). */
  pageType: 'home' | 'sub';
}
const { lang, pageType } = Astro.props;

const strings = {
  fr: {
    newsletter: 'Abonnez-vous à notre newsletter', emailPlaceholder: 'Votre email',
    newsletterSubject: 'Newsletter signup - AgiFid',
    tagline: 'Fiduciaire 100% dédiée aux sociétés sur Odoo',
    why: 'Pourquoi nous', services: 'Services', contact: 'Contact', blog: 'Actualités', about: 'À propos', agitech: 'Agitech',
    nav: 'Navigation', whyAnchor: 'pourquoi',
    rights: '© 2026 AgiFid. Tous droits réservés.',
    privacy: 'Politique de Confidentialité', terms: 'Conditions générales', manage: 'Gérer les cookies',
  },
  en: {
    newsletter: 'Subscribe to our newsletter', emailPlaceholder: 'Your email',
    newsletterSubject: 'Newsletter signup (EN) - AgiFid',
    tagline: 'Accounting firm 100% dedicated to companies on Odoo',
    why: 'Why us', services: 'Services', contact: 'Contact', blog: 'Insights', about: 'About', agitech: 'Agitech',
    nav: 'Navigation', whyAnchor: 'why',
    rights: '© 2026 AgiFid. All rights reserved.',
    privacy: 'Privacy Policy', terms: 'General Terms', manage: 'Manage cookies',
  },
  nl: {
    newsletter: 'Schrijf u in voor onze nieuwsbrief', emailPlaceholder: 'Uw e-mailadres',
    newsletterSubject: 'Newsletter signup (NL) - AgiFid',
    tagline: 'Accountantskantoor 100% gewijd aan bedrijven op Odoo',
    why: 'Waarom wij', services: 'Diensten', contact: 'Contact', blog: 'Nieuws', about: 'Over ons', agitech: 'Agitech',
    nav: 'Navigatie', whyAnchor: 'waarom',
    rights: '© 2026 AgiFid. Alle rechten voorbehouden.',
    privacy: 'Privacybeleid', terms: 'Algemene voorwaarden', manage: 'Cookies beheren',
  },
}[lang];

const legal = {
  fr: { privacy: '/politique-de-confidentialite.html', terms: '/conditions-generales.html' },
  en: { privacy: '/privacy-policy-en.html', terms: '/terms-and-conditions-en.html' },
  nl: { privacy: '/privacybeleid-nl.html', terms: '/algemene-voorwaarden-nl.html' },
}[lang];

const base = pageType === 'home' ? '' : { fr: '/index.html', en: '/index-en.html', nl: '/index-nl.html' }[lang];
---
<div class="brand-bar"></div>
<footer>
  <div class="container">
    <div class="row main-row">
      <div class="item">
        <div class="content">
          <h6>{strings.newsletter}</h6>
          <!-- Sent via Formspree (dedicated newsletter endpoint, separate from the contact form).
               No real list/unsubscribe management - a proper emailing tool (Brevo/Mailchimp) should replace this later. -->
          <form class="tnp-subscription" action="https://formspree.io/f/xeajdqgr" method="POST">
            <input class="tnp-email" type="email" name="email" placeholder={strings.emailPlaceholder} required>
            <input type="hidden" name="_subject" value={strings.newsletterSubject}>
            <button class="tnp-submit" type="submit">→</button>
          </form>
        </div>
      </div>
      <div class="item">
        <div class="top-text"><h5>{strings.tagline}</h5></div>
        <div class="content">
          <div class="address">
            <h6>Mfinances</h6>
            <p>11 Clos Lucien Outers, 1160</p>
            <p>Brussels, Belgium</p>
            <p>TVA BE 0827635870</p>
          </div>
        </div>
      </div>
      <div class="item ft-links">
        <div class="content">
          <h6>{strings.nav}</h6>
          <ul>
            <li><a href={`${base}#${strings.whyAnchor}`}>{strings.why}</a></li>
            <li><a href={`${base}#services`}>{strings.services}</a></li>
            <li><a href={`${base}#contact`}>{strings.contact}</a></li>
            <li><a href={{ fr: '/actualites.html', en: '/actualites-en.html', nl: '/actualites-nl.html' }[lang]}>{strings.blog}</a></li>
            {lang === 'fr' && <li><a href="/a-propos.html">{strings.about}</a></li>}
            <li><a href={{ fr: '/carrieres.html', en: '/carrieres-en.html', nl: '/carrieres-nl.html' }[lang]}>Jobs</a></li>
            <li><a href="https://agitech.io" target="_blank" rel="noopener">{strings.agitech}</a></li>
          </ul>
          <div class="social-icons">
            <a href="https://www.linkedin.com/company/agitechbelgium/" target="_blank" rel="noopener"><img src="/assets/img/linkedin.svg" alt="LinkedIn" width="38" height="39"></a>
            <a href="https://www.youtube.com/@Agitech-OdooPartner" target="_blank" rel="noopener"><img src="/assets/img/youtube.svg" alt="YouTube" width="40" height="40"></a>
            <a href="https://wa.me/32460241589" target="_blank" rel="noopener"><img src="/assets/img/whatsap.svg" alt="WhatsApp" width="40" height="40"></a>
          </div>
        </div>
      </div>
    </div>
    <div class="copy-right">
      <p>{strings.rights}</p>
      <p class="privacy-links"><a href={legal.privacy}>{strings.privacy}</a>&nbsp;|&nbsp;<a href={legal.terms}>{strings.terms}</a>&nbsp;|&nbsp;<a href="#" data-cookie-settings>{strings.manage}</a></p>
    </div>
  </div>
</footer>
